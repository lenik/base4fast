[lrm-bootstrap-epel]
name=lrm bootstrap EPEL 10
baseurl=https://mirrors.aliyun.com/epel/10/Everything/$basearch/
        https://mirrors.tuna.tsinghua.edu.cn/epel/10/Everything/$basearch/
gpgcheck=0
enabled=1
skip_if_unavailable=1
