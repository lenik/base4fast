[lrm-bootstrap-baseos]
name=lrm bootstrap Rocky 9 BaseOS
baseurl=https://mirrors.aliyun.com/rockylinux/9/BaseOS/$basearch/os/
        https://mirrors.tuna.tsinghua.edu.cn/rocky/9/BaseOS/$basearch/os/
        https://mirrors.ustc.edu.cn/rocky/9/BaseOS/$basearch/os/
        https://mirrors.huaweicloud.com/rockylinux/9/BaseOS/$basearch/os/
gpgcheck=0
enabled=1
skip_if_unavailable=1

