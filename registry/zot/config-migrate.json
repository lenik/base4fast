{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "gc": false,
    "dedupe": true
  },
  "http": {
    "address": "0.0.0.0",
    "port": "3244",
    "compat": ["docker2s2"],
    "tls": {
      "cert": "/certs/domain.crt",
      "key": "/certs/domain.pem"
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "ui": {
      "enable": true
    },
    "search": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://127.0.0.1:3245"],
          "onDemand": true,
          "pollInterval": "2m",
          "tlsVerify": false,
          "preserveDigest": true,
          "maxRetries": 5,
          "retryDelay": "30s",
          "content": [
            {
              "prefix": "**"
            }
          ]
        }
      ]
    }
  }
}
